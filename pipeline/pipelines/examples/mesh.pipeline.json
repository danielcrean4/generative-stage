{
  "version": 1,
  "id": "mesh",
  "name": "A rough 3D model from a concept image",
  "kind": "prop",
  "capture": {
    "background": {
      "method": "near_white",
      "color": [
        255,
        255,
        255
      ],
      "tolerance": 236,
      "words": "plain white background"
    },
    "framing": {
      "words": "single object, whole object in frame, even light, no cast shadow"
    },
    "view": {
      "words": "three-quarter view",
      "camera": {
        "yaw": [
          -30,
          30,
          15
        ],
        "elevation": [
          -30,
          0,
          10
        ]
      }
    }
  },
  "stages": [
    {
      "id": "concept",
      "label": "Concept image",
      "tool": "concept",
      "inputs": {},
      "reads": [
        "capture",
        "style.prompt",
        "subject",
        "motif"
      ],
      "params": {
        "width": 512,
        "height": 512
      },
      "outputs": [
        "image.png"
      ]
    },
    {
      "id": "tidy_image",
      "label": "Tidy the image",
      "tool": "normalize_image",
      "inputs": {
        "image": "concept/image.png"
      },
      "reads": [
        "capture.background"
      ],
      "params": {
        "canvas_size": 512,
        "margin": 32,
        "output_mode": "rgba"
      },
      "outputs": [
        "image.png"
      ]
    },
    {
      "id": "matte",
      "label": "Find the subject",
      "tool": "matte",
      "inputs": {
        "image": "tidy_image/image.png"
      },
      "reads": [
        "capture.background"
      ],
      "params": {},
      "gate": {
        "min_largest_share": 0.95,
        "min_coverage": 0.05,
        "max_coverage": 0.9,
        "allow_border": false
      },
      "outputs": [
        "matte.png",
        "matte.json"
      ]
    },
    {
      "id": "mesh",
      "label": "Image to mesh",
      "tool": "mesh",
      "inputs": {
        "image": "tidy_image/image.png"
      },
      "reads": [],
      "params": {
        "steps": 50,
        "depth": 8
      },
      "outputs": [
        "mesh.glb"
      ]
    }
  ],
  "choices": {
    "style": {
      "label": "Style",
      "options": [
        "clay",
        "vinyl_toy"
      ],
      "default": "clay"
    },
    "motif": {
      "label": "Motif",
      "options": [
        "repair_shop",
        "plain"
      ],
      "default": "repair_shop"
    },
    "seed": {
      "label": "Seed",
      "min": 0,
      "max": 4294967295,
      "default": 1
    },
    "candidates": {
      "label": "Candidates",
      "min": 1,
      "max": 4,
      "default": 1
    },
    "start_image": {
      "label": "Make it from the image chosen as",
      "slots": [
        "main"
      ],
      "start_at": "tidy_image",
      "supplies": "concept/image.png"
    }
  }
}
